+// Cierre ordenado: Render envía SIGTERM en cada deploy o suspensión.
+// Se deja de aceptar conexiones, se terminan las peticiones en curso y se
+// liberan las conexiones del pooler de Supabase antes de salir.
+let shuttingDown = false;
+
+async function shutdown(signal: string) {
+  if (shuttingDown) return;
+  shuttingDown = true;
+  console.log(`${signal} recibido, cerrando servidor...`);
+
+  // Red de seguridad: si algo queda colgado, salir igualmente.
+  setTimeout(() => {
+    console.error("Cierre forzado por timeout");
+    process.exit(1);
+  }, 10_000).unref();
+
+  server.close(async () => {
+    try {
+      await prisma.$disconnect();
+    } finally {
+      process.exit(0);
+    }
+  });
+}
+
+process.on("SIGTERM", () => void shutdown("SIGTERM"));
+process.on("SIGINT", () => void shutdown("SIGINT"));
+
+export default app;
diff --git a/backend/prisma/migrations/20260907000000_rls_prisma_migrations/migration.sql b/backend/prisma/migrations/20260907000000_rls_prisma_migrations/migration.sql
new file mode 100644
index 0000000..eb603f0
--- /dev/null
+++ b/backend/prisma/migrations/20260907000000_rls_prisma_migrations/migration.sql
@@ -0,0 +1,4 @@
+-- Supabase expone el esquema public por su Data API (PostgREST).
+-- Se activa RLS en la tabla interna de Prisma para que no sea accesible con la anon key.
+-- Prisma conecta como dueño de la tabla (rol postgres), que no se ve afectado por RLS.
+ALTER TABLE "_prisma_migrations" ENABLE ROW LEVEL SECURITY;
diff --git a/backend/prisma/migrations/20260907000100_search_index_tuning/migration.sql b/backend/prisma/migrations/20260907000100_search_index_tuning/migration.sql
new file mode 100644
index 0000000..948f30b
--- /dev/null
+++ b/backend/prisma/migrations/20260907000100_search_index_tuning/migration.sql
@@ -0,0 +1,8 @@
+-- Índice duplicado: idx_productos_locales_nombre_trgm (init) e idx_productos_nombre_trgm
+-- (search_indexes) son idénticos. Se conserva este último.
+DROP INDEX IF EXISTS idx_productos_locales_nombre_trgm;
+
+-- La búsqueda usa ILIKE '%texto%' también sobre codigo_proveedor; el índice btree
+-- existente no sirve para ese patrón, un índice trigram sí.
+CREATE INDEX IF NOT EXISTS idx_equivalencias_codigo_proveedor_trgm
+  ON equivalencias USING gin (codigo_proveedor gin_trgm_ops);
